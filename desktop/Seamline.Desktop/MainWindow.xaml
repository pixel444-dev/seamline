<Window x:Class="Seamline.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource SeamlineWindow}"
        Title="Seamline" Height="650" Width="1060" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="100" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Cabeçalho: logo, nome e situação da conexão -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
            <Image Source="{StaticResource LogoIcon}" Width="44" Height="44" DockPanel.Dock="Left" />
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="14" Padding="12,6"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource StatusOffBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Desconectado" Margin="8,0,0,0" MaxWidth="260"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Seamline" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Seu celular dentro do PC" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <!-- 1. Escolher e conectar o celular -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource CardIconBox}">
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8EA;" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Celular" />
                    </DockPanel>
                    <DockPanel>
                        <Button x:Name="PairButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="PairButton_Click"
                                ToolTip="Conectar um celular novo pelo Wi-Fi lendo um QR code">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Parear pelo Wi-Fi" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                Content="&#xE72C;" Click="RefreshButton_Click" ToolTip="Procurar celulares de novo" />
                        <ComboBox x:Name="DeviceList" Tag="Nenhum celular encontrado" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" MinWidth="130"
                                Content="Conectar" Click="ConnectButton_Click" />
                        <Button x:Name="PingButton" Margin="8,0,0,0" IsEnabled="False" Click="PingButton_Click"
                                ToolTip="Mede quanto tempo o celular demora para responder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Testar conexão" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Mouse e teclado pela borda -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <Border Style="{StaticResource CardIconBox}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource CardIcon}" Text="&#xE962;" />
                    </Border>
                    <CheckBox x:Name="BridgeCheck" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                              Checked="BridgeCheck_Changed" Unchecked="BridgeCheck_Changed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Mouse e teclado no celular" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                Leve o cursor até a <Run Foreground="{StaticResource TextBrush}">borda esquerda do monitor</Run> e ele passa para o celular.
                                Para voltar, empurre pela borda direita do celular ou aperte <Run Foreground="{StaticResource TextBrush}">Ctrl+Alt+Esc</Run>.
                            </TextBlock>
                        </StackPanel>
                    </CheckBox>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- 3. Mover apps e janelas -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource CardIconBox}">
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8AB;" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Mover entre o celular e o PC" />
                    </DockPanel>

                    <DockPanel>
                        <Button x:Name="BringAppButton" DockPanel.Dock="Right" MinWidth="190" VerticalAlignment="Center" IsEnabled="False" Click="BringAppButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Trazer para o PC" />
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="App aberto no celular" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Text="Abre numa janela do PC, que dá para mover e redimensionar." />
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />

                    <TextBlock Text="Janela do PC" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" Text="Aparece na tela do celular. Voltar no celular devolve a janela." />
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="SendWindowButton" DockPanel.Dock="Right" MinWidth="190" Margin="8,0,0,0" IsEnabled="False"
                                Click="SendWindowButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Mandar para o celular" />
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="WindowList" Tag="Escolha uma janela..." DropDownOpened="WindowList_DropDownOpened" />
                    </DockPanel>

                    <!-- Dica dos gestos de arrastar -->
                    <Border Margin="0,14,0,0" CornerRadius="8" Padding="12,10" Background="{StaticResource SurfaceAltBrush}">
                        <DockPanel>
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="#8FB0FF"
                                       VerticalAlignment="Top" Margin="0,2,10,0" />
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Foreground="{StaticResource TextBrush}" FontWeight="SemiBold">Dá para arrastar também.</Run>
                                No celular, segure o botão esquerdo e empurre para fora pela borda: o app vem junto.
                                No PC, arraste uma janela e empurre com força contra a borda esquerda: ela vai para o celular.
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Registro do que está acontecendo (útil para achar problemas) -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Top" Text="REGISTRO" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSubtleBrush}" Margin="2,0,0,6" />
            <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </DockPanel>
    </Grid>
</Window>
