<Window x:Class="Seamline.Desktop.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource SeamlineWindow}"
        Title="Parear o celular pelo Wi-Fi" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Bolinha com o número do passo -->
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="StepNumberText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8FB0FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24" Width="640">
        <DockPanel>
            <!-- O QR precisa de fundo branco para a câmera ler. -->
            <Border DockPanel.Dock="Left" Background="White" Padding="10" CornerRadius="14" VerticalAlignment="Top">
                <Image x:Name="QrImage" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <StackPanel Margin="24,0,0,0">
                <TextBlock Text="Leia este QR code com o celular" FontWeight="SemiBold" FontSize="18" />
                <TextBlock Style="{StaticResource StepText}" Margin="0,4,0,16"
                           Text="É só na primeira vez. Depois o PC lembra do celular." />

                <DockPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Style="{StaticResource StepNumberText}" Text="1" /></Border>
                    <TextBlock Style="{StaticResource StepText}">
                        Deixe o PC e o celular na <Run Foreground="{StaticResource TextBrush}" FontWeight="SemiBold">mesma rede Wi-Fi</Run>.
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                    <Border Style="{StaticResource StepNumber}"><TextBlock Style="{StaticResource StepNumberText}" Text="2" /></Border>
                    <TextBlock Style="{StaticResource StepText}">
                        No celular, abra <Run Foreground="{StaticResource TextBrush}" FontWeight="SemiBold">Configurações → Opções do desenvolvedor → Depuração sem fio</Run>
                        e ligue a chave. (O app Seamline do celular tem um botão que abre essa tela.)
                    </TextBlock>
                </DockPanel>
                <DockPanel>
                    <Border Style="{StaticResource StepNumber}"><TextBlock Style="{StaticResource StepNumberText}" Text="3" /></Border>
                    <TextBlock Style="{StaticResource StepText}">
                        Toque em <Run Foreground="{StaticResource TextBrush}" FontWeight="SemiBold">Parear dispositivo com código QR</Run>
                        e aponte a câmera para este QR.
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </DockPanel>

        <!-- Situação do pareamento -->
        <Border Margin="0,20,0,0" CornerRadius="10" Padding="14,12" Background="{StaticResource AccentSoftBrush}">
            <DockPanel>
                <TextBlock Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#8FB0FF"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="Esperando o celular ler o QR code..." />
            </DockPanel>
        </Border>

        <Expander Header="Não deu certo com o QR? Parear com código de 6 dígitos" Margin="0,16,0,0">
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource StepText}">
                        Na tela Depuração sem fio, toque em <Run Foreground="{StaticResource TextBrush}" FontWeight="SemiBold">Parear dispositivo com código de pareamento</Run>.
                        O celular mostra um código e um endereço (IP e porta). Se o PC achar o celular sozinho,
                        o endereço já aparece preenchido aqui.
                    </TextBlock>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Endereço" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="AddressBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Código" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="CodeBox" MaxLength="6" />
                        </StackPanel>
                        <Button x:Name="CodeButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Parear"
                                Margin="10,0,0,0" VerticalAlignment="Bottom" Click="CodeButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>

        <Button Content="Fechar" HorizontalAlignment="Right" MinWidth="100" Margin="0,18,0,0" IsCancel="True" />
    </StackPanel>
</Window>
