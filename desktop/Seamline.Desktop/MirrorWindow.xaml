<Window x:Class="Seamline.Desktop.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource SeamlineWindow}"
        Title="Seamline" Background="Black" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">
    <!-- Clique esquerdo = toque, direito = Voltar, do meio = Início, roda = rolar (veja ScreenInput). -->
    <Image x:Name="Screen" Stretch="Uniform" Cursor="Hand"
           RenderOptions.BitmapScalingMode="HighQuality" />
</Window>
