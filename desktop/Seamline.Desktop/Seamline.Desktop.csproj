<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A versão do Windows no nome libera as APIs do Windows 10+ (captura de janelas, Fase 5). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Seamline</AssemblyName>
    <!-- Versão mostrada no instalador e nas propriedades do .exe (mantenha igual à do app Android). -->
    <Version>0.1.0</Version>
    <!-- Só as traduções do .NET/WPF que usamos (as outras só deixariam o instalador maior). -->
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
    <!-- A conversão de cor dos quadros de vídeo usa ponteiros, por desempenho. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Ícone do .exe (gerado de Assets/Logo.xaml por tools/gerar-icone.cs). -->
    <ApplicationIcon>Assets\seamline.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- O "server" Android (gerado pelo Gradle em android/server) vai junto do .exe. -->
  <PropertyGroup>
    <ServerApk>..\..\android\server\build\outputs\apk\debug\server-debug.apk</ServerApk>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ServerApk)')">
    <None Include="$(ServerApk)" Link="seamline-server.apk" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- O app Android também: o PC instala/atualiza no celular quando precisa mostrar uma janela lá. -->
  <PropertyGroup>
    <AppApk>..\..\android\app\build\outputs\apk\debug\app-debug.apk</AppApk>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(AppApk)')">
    <None Include="$(AppApk)" Link="seamline-app.apk" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ícone das janelas -->
    <Resource Include="Assets\seamline.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <!-- Direct3D 11: recebe as imagens da captura de janelas (Fase 5). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- Gera o QR code do pareamento pela Depuração sem fio. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
